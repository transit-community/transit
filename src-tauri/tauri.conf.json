{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Transit Community Edition",
  "version": "6.5.10",
  "identifier": "app.transit.community",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "windows": {
      "staticVCRuntime": false
    }
  },
  "app": {
    "windows": [
      {
        "title": "Transit Community Edition",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../policies/*.yaml": "policies/"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "./bundle/transit-community.desktop"
      },
      "rpm": {
        "desktopTemplate": "./bundle/transit-community.desktop",
        "depends": ["webkit2gtk4.1", "gtk3", "libsoup3"]
      }
    }
  }
}
